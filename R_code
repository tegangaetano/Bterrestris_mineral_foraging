#DATA####
#Reduce dataset to desired columns
Behav_data <- Behav_data[c('date', 'observer', 'duration_mins',
                           'temp_C', 'humidity',
                           'colony', 'arena',
                           'analyte', 'concentration', 'PPM',
                           'corrected_av_per_bee_mL', 
                           'av_total_consumed_mL')]

Behav_data <- as.data.frame(Behav_data)

#Convert data to numeric
Behav_data$PPM <- as.numeric(Behav_data$PPM)

#Create new PPM as a factor
Behav_data$fPPM <- as.factor(Behav_data$PPM)

#Change the decimal humidity to a percent
Behav_data$humidity_percent <- Behav_data$humidity * 100

#Convert data to factor
Behav_data$observer <- as.factor(Behav_data$observer)
Behav_data$arena <- as.factor(Behav_data$arena)
Behav_data$colony <- as.factor(Behav_data$colony)
Behav_data$analyte <- as.factor(Behav_data$analyte)
Behav_data$concentration <- factor(Behav_data$concentration, 
                                   levels = c('control', 
                                              'low', 
                                              'low_medium',
                                              'medium',
                                              'medium_high',
                                              'high'))

#Add column for new PI algorithm (t-(T/6)/T)
Behav_data$new_PI <- ((Behav_data$corrected_av_per_bee_mL -                       (Behav_data$av_total_consumed_mL / 6)) /
                        Behav_data$av_total_consumed_mL)

Behav_data$new_PI <- as.numeric(Behav_data$new_PI)

dim(Behav_data)
