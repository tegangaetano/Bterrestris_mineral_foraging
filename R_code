#Analysis by analyte####
#Potential random effects to include: date (17 levels), colony (10 levels), observer (3 levels), arena (2 levels)
#Sodium (Na) ####
#Run model on Na data####
Na_PI_model <- glmmTMB(new_PI ~ fPPM + 
                         (1 | date) +
                         (1 | colony),
                        family = gaussian, 
                       data = Na_data)

#Polynomial models to fit a curve
Na_PI_poly_red <- glmmTMB(new_PI ~ poly(PPM, 2) +
                            (1 | date) +
                            (1 | colony),
                          family = gaussian, 
                          data = Na_data)
#Two terms fits the curve!

Na_PI_poly_red2 <- glmmTMB(new_PI ~ poly(PPM, 1) +
                            (1 | date) +
                            (1 | colony),
                          family = gaussian, 
                          data = Na_data)
#One term is not better than two terms

AIC(Na_PI_poly_red, Na_PI_poly_red2)
#df       AIC
#Na_PI_poly_red   6 -182.7287
#Na_PI_poly_red2  5 -175.3794

#Check model assumptions
check_model(Na_PI_model) #OK
check_model(Na_PI_poly_red) #OK

#Dharma tests
sim_Output <- simulateResiduals(Na_PI_model, n = 250) #OK 
sim_Output <- simulateResiduals(Na_PI_poly_red, n = 250) #KS test significant, p = 0.0389; outlier test significant, p = 0.04184

plot(sim_Output)
testResiduals(sim_Output)

