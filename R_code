#Analysis####
#Using LMM with humidity and temperature as continuous explanatory variables, analyte as a fixed categorical variable and date, arena, and colony as random effects.
clim_model <- glmmTMB(corrected_av_per_bee_mL ~ 
                      scale(temp_C) * scale(humidity_percent) +
                        analyte * concentration +
                        (1 | date) +
                      (1 | colony),
                      family = beta_family,
                        data = Behav_data)

Anova(clim_short)

#Check model assumptions
check_model(clim_model) #OK

#Dharma tests
sim_Output <- simulateResiduals(clim_model, n = 250)

plot(sim_Output) #OK
testResiduals(sim_Output) 

#interaction plot with temperature on the x axis
flip_plot <- interact_plot(clim_model, pred = humidity_percent, modx = temp_C, 
                               interval = TRUE, int.width = 0.6,
                               plot.points = FALSE,
                               data = Behav_data,
                               x.label = 'Humidity (%)',
                               y.label = 'Average Consumption per Bee (mL)',
                               legend.main = 'Temperature (C)',
                               main = '') +
  theme_classic() + theme(axis.text = element_text(size = 10),
                      axis.title = element_text(size = 14))

flip_plot

ggsave("interaction_plot.png", plot = flip_plot, width = 6, height = 4, units = "in", dpi = 300)

